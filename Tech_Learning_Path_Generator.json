    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst prompt = `Analyze these learning resources for ${data.technology}:\n\nTotal: ${data.totalResources} resources found\n- GitHub repos: ${data.githubCount}\n- Dev.to articles: ${data.devtoCount}\n- StackOverflow questions: ${data.stackoverflowCount}\n\nKey resources:\n${data.resourcesText}\n\nGenerate a structured Learning Path including:\n1. 📅 Weekly roadmap (Week 1, Week 2, Week 3)\n2. ⭐ Top resources by platform\n3. ⏱️ Estimated learning time\n4. 📈 Difficulty level\n\nFormat: Markdown with emojis and clear sections.`;\n\nreturn [{\n  json: {\n    model: \"gemini-2.5-flash\",\n    messages: [\n      {\n        role: \"user\",\n        content: prompt\n      }\n    ]\n  }\n}];"
      },
