    {
      "parameters": {
        "jsCode": "// Obtenemos todos los inputs\nconst allInputs = $input.all();\n\n// Capturamos la tecnología del primer input que la tenga\nconst techInput = allInputs.find(input => input.json.technology);\nconst technology = techInput ? techInput.json.technology : 'unknown';\n\nlet githubRepos = [];\nlet devtoArticles = [];\nlet stackoverflowQuestions = [];\n\n// Procesamos cada input\nfor (const input of allInputs) {\n  const data = input.json;\n  \n  // GitHub\n  if (data.items && data.items.length > 0 && data.items[0]?.full_name) {\n    githubRepos = data.items.map(repo => ({\n      title: repo.full_name,\n      url: repo.html_url,\n      stars: repo.stargazers_count,\n      description: (repo.description || 'No description').substring(0, 100)\n    }));\n  }\n  \n  // Dev.to\n  if (Array.isArray(data)) {\n    devtoArticles = data.map(article => ({\n      title: article.title,\n      url: article.url,\n      reactions: article.public_reactions_count || 0\n    }));\n  } else if (data.type_of === 'article') {\n    devtoArticles = [{\n      title: data.title,\n      url: data.url,\n      reactions: data.public_reactions_count || 0\n    }];\n  }\n  \n  // StackOverflow\n  if (data.items && data.items.length > 0 && data.items[0]?.question_id) {\n    stackoverflowQuestions = data.items.map(item => ({\n      title: item.title,\n      url: item.link,\n      score: item.score\n    }));\n  }\n}\n\n// Crear texto resumen de recursos\nconst resourceText = [\n  ...githubRepos.map(r => `📦 GitHub: ${r.title} (⭐${r.stars})\\n   ${r.url}`),\n  ...devtoArticles.map(r => `📝 Dev.to: ${r.title} (❤️${r.reactions})\\n   ${r.url}`),\n  ...stackoverflowQuestions.map(r => `❓ StackOverflow: ${r.title} (👍${r.score})\\n   ${r.url}`)\n].join('\\n\\n');\n\nreturn [{\n  json: {\n    technology: technology,\n    totalResources: githubRepos.length + devtoArticles.length + stackoverflowQuestions.length,\n    githubCount: githubRepos.length,\n    devtoCount: devtoArticles.length,\n    stackoverflowCount: stackoverflowQuestions.length,\n    resourcesText: resourceText\n  }\n}];"
      },
